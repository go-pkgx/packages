# A build environment with NO distribution in it: `FROM scratch`, three static
# CGO_ENABLED=0 Go binaries, and every build tool coming from a pkgx bottle.
#
# This file produces an IMAGE. For a DIRECTORY — what a micro-VM actually boots,
# and what stages on any host with no docker and no root — use `bk builder`
# instead; see README.md. Both stage the same rootfs from the same toolchain.txt.
#
#   bk    the build driver — fetch, patch, script, fix-up and bottle, all in Go
#   pkgx  materialises a recipe's build deps and prints the environment bk's
#         generated script evals
#   pkgm  bootstraps the toolchain closure into the image, and poses the loader
#         and /bin/sh so the rootfs can actually run something
#
# Build it with the three binaries in the context:
#
#   for r in bk pkgm pkgx; do
#     GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -o builder/$r github.com/go-pkgx/$r/...
#   done
#   docker build -f builder/Containerfile -t bk-builder builder
#
# and compile with it (the pantry mounted, the output bind-mounted out):
#
#   docker run --rm -v "$PWD/pantry:/pantry:ro" -v "$PWD/out:/out" bk-builder \
#     factory --platform linux/aarch64 --pantry /pantry --recipes lz4.org \
#             --libc pkgx --bottles /out/dist --to oci://…
FROM scratch
ENV PKGX_DIR=/pkgx
ENV HOME=/root
# PKGX_DIST can point at a local pull-through cache so a rebuild does not fetch
# gigabytes from ghcr again (see README): build with
#   --build-arg DIST=oci://http://host.docker.internal:5111/go-pkgx/packages
# Signature verification stays ON through the cache — it proxies the cosign
# referrer as well as the bottle.
ARG DIST=oci://ghcr.io/go-pkgx/packages
ENV PKGX_DIST=$DIST
# Recipes are read from the upstream pantry, where a few still pin constraints
# no published bottle satisfies (curl.se asks for openssl ^1.1; openssl is 3.x
# and 4.x). overrides/ fixes those for BUILDS, but installing reads the pantry
# directly — so the image consults our small corrected overlay first, exactly as
# the from-scratch panel does.
ENV PKGX_PANTRY_OVERLAY=https://raw.githubusercontent.com/go-pkgx/pantry-overlay/main/projects

COPY pkgm /pkgm
COPY pkgx /usr/local/bin/pkgx
COPY bk /usr/local/bin/bk

# The toolchain, from bottles only — and the proof: if it installs and runs here,
# no distribution is involved. The list lives in a committed file rather than in
# this RUN line, so it can be reviewed and diffed like anything else (and each
# entry says why it is there).
#
# llvm.org goes in FIRST, on its own layer: it is the bulk of the image and
# changes far less often than the rest, so editing the list re-uses this layer
# instead of pulling ~1.7 GiB again.
RUN ["/pkgm","install","-s","--prefix","/usr","llvm.org"]
COPY toolchain.txt /toolchain.txt
RUN ["/pkgm","install","-s","--prefix","/usr","-f","/toolchain.txt"]

# bk runs THROUGH pkgx, which composes PATH/LD_LIBRARY_PATH/CPATH from the
# installed bottles at run time. Hardcoding a library path would pin a glibc
# version into the image; this stays correct when the toolchain moves.
ENTRYPOINT ["/usr/local/bin/pkgx", \
            "+gnu.org/glibc","+gnu.org/coreutils","+gnu.org/make","+llvm.org", \
            "--","/usr/local/bin/bk"]
