diff --git a/projects/mozilla.org/nss/package.yml b/projects/mozilla.org/nss/package.yml
index d791208..df64acc 100644
--- a/projects/mozilla.org/nss/package.yml
+++ b/projects/mozilla.org/nss/package.yml
@@ -26,6 +26,29 @@ build:
       llvm.org: "*"
   script:
     - run:
+        # nss compiles its own source with -Werror, and clang 23.1.1 added a
+        # warning its source trips, so the build died before it linked anything:
+        #
+        #   httpserv.c:58:25: error: variable 'lm' set but not used
+        #                             [-Werror,-Wunused-but-set-global]
+        #   httpserv.c:141:12: error: variable 'threadCount' set but not used
+        #
+        # -Werror is a guard on nss's development against warnings its authors
+        # have not seen yet. Downstream it turns every warning a NEWER compiler
+        # learns into a failed build, which is what happened here: nothing in
+        # this recipe changed, the compiler did.
+        #
+        # NSS_ENABLE_WERROR=0 would drop -Werror entirely. This keeps it and
+        # downgrades exactly one warning, through coreconf's OWN probe —
+        # set_warning emits the flag only if the compiler admits it, so the
+        # darwin/x86-64 lane, which uses a different clang, is not handed a
+        # flag it may not know while -Werror is in force.
+        #
+        # The grep is the point of the sed: if upstream rewrites that line, the
+        # substitution would silently do nothing and the build would fail again
+        # with the same message and no clue why.
+        - grep -q 'WARNING_CFLAGS += -Werror$' coreconf/Werror.mk
+        - sed -i 's|WARNING_CFLAGS += -Werror$|WARNING_CFLAGS += -Werror $(call set_warning,unused-but-set-global,no-error=)|' coreconf/Werror.mk
         - sed -i 's|-install_name @executable_path|-install_name {{prefix}}/lib|g' coreconf/Darwin.mk
         - sed -i 's|@executable_path|{{prefix}}/lib|g' lib/freebl/config.mk
         - make all $ARGS
