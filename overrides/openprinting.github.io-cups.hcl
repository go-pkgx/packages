project = "openprinting.github.io/cups"
why     = "This recipe pins openssl to a 1.x line. Our registry holds no 1.x bottle — every one of the 48 is 3.x or 4.x — so the recipe dies in the resolver before a compiler runs: `no version of openssl.org satisfies \"^1.1\"`. openssl 1.1.1 has been end-of-life since September 2023, so pinning it is not an alternative. Generated by ./openssl3; delete this when upstream retargets the pin. The build.script edit is separate and is NOT openssl3's: it stops `make install` from stripping, because GNU strip destroys a Mach-O and exits 0 (go-pkgx/bk#161)."

edits = [
  {
    path = "build.env.DSOFLAGS"
    set = "$LDFLAGS"
  },
  {
    # ⛔ `expect` DESCRIBES UPSTREAM, so it moves when upstream moves — and on
    # 2026-10-18 it did. This edit stopped applying with
    #
    #   openprinting.github.io/cups: build.script is not what this replaces any more
    #
    # because upstream PREPENDED a step: a conditional `sed` patching
    # cups/dest.c for >=2.4.20, where 2.4.20 uses data.num_local and
    # local_dests outside HAVE_DNSSD while declaring them only in the DNS-SD
    # struct. Nothing we do was wrong; the premise simply aged.
    #
    # Both lists are the HCL that `bk tohcl` renders from upstream's current
    # package.yml, not retyped: a heredoc and a conditional map transcribed by
    # hand are exactly where a premise silently stops matching.
    path = "build.script"
    set = [
      {
        if   = ">=2.4.20"
        prop = <<EOT
/^typedef struct _cups_getdata_s/,/^} _cups_getdata_t;/{
/def_instance;/a\
  int num_local;\
  cups_dest_t *local_dests;
}
EOT
        run  = "sed -i -f $PROP cups/dest.c"
      },
      "./configure $ARGS",
      # OURS, and the only line this edit exists for. `make install` runs
      # install with -s; stripping a Mach-O after it is signed leaves a binary
      # the arm64 kernel kills on sight, with no message (go-pkgx/bk#161).
      "sed -i -E 's/^(INSTALL_(BIN|LIB)[[:space:]]*=.*[^-])[[:space:]]-s[[:space:]]*$/\\1/' Makedefs",
      "make --jobs {{ hw.concurrency }} install",
    ]
    expect = [
      {
        if   = ">=2.4.20"
        prop = <<EOT
/^typedef struct _cups_getdata_s/,/^} _cups_getdata_t;/{
/def_instance;/a\
  int num_local;\
  cups_dest_t *local_dests;
}
EOT
        run  = "sed -i -f $PROP cups/dest.c"
      },
      "./configure $ARGS",
      "make --jobs {{ hw.concurrency }} install",
    ]
  },
  {
    path = "dependencies.linux[\"openssl.org\"]"
    set = "^3"
  },
]
