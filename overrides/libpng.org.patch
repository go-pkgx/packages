diff --git a/projects/libpng.org/package.yml b/projects/libpng.org/package.yml
index cb09f6c..77fa8d0 100644
--- a/projects/libpng.org/package.yml
+++ b/projects/libpng.org/package.yml
@@ -11,10 +11,26 @@ dependencies:
   zlib.net: 1
 
 build:
+  # Use libpng's shipped known-good pnglibconf.h instead of the generated one.
+  # libpng derives pnglibconf.h (which sets PNG_SETJMP_SUPPORTED and the whole
+  # feature set) by running its option .dfa through awk (options.awk/dfn.awk).
+  # Under the factory toolchain that generation silently drops the SETJMP option,
+  # so png_jmpbuf() expands to libpng's poison macro
+  # (LIBPNG_WAS_COMPILED_WITH__PNG_NO_SETJMP), the bundled test programs fail to
+  # compile and the build aborts — worse, it would ship a setjmp-less (degraded)
+  # library. libpng ships scripts/pnglibconf.h.prebuilt exactly for hosts whose
+  # awk can't process the .dfa; it has the standard feature set (setjmp on).
+  # Generate the tree's prereqs, then overwrite the header with the prebuilt and
+  # make it newer than pnglibconf.out so `make` treats it as up-to-date and does
+  # not regenerate it. (Neither CFLAGS nor CPP/DFNCPP fixes this — the option is
+  # dropped at the awk stage.)
   - ./configure
     --disable-dependency-tracking
     --disable-silent-rules
     --prefix {{ prefix }}
+  - make pnglibconf.h
+  - cp scripts/pnglibconf.h.prebuilt pnglibconf.h
+  - touch pnglibconf.h
   - make --jobs {{ hw.concurrency }}
   - make install
 
