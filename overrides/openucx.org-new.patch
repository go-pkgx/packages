diff --git a/projects/openucx.org/package.yml b/projects/openucx.org/package.yml
new file mode 100644
index 0000000..4f4c051
--- /dev/null
+++ b/projects/openucx.org/package.yml
@@ -0,0 +1,153 @@
+# UCX — the transport layer an MPI actually runs over on a cluster.
+#
+# The pantry carries open-mpi.org, PMIx and hwloc but nothing beneath them, so
+# an OpenMPI built from it falls back to TCP: correct, and on an InfiniBand or
+# RoCE fabric roughly an order of magnitude off what the hardware can do. UCX is
+# what OpenMPI, MPICH and OpenSHMEM all use to reach shared memory and RDMA.
+#
+# rdma-core landed (github.com/linux-rdma/rdma-core 65.0), so this now builds
+# WITH verbs: the ib transports — rc, ud, dc over InfiniBand or RoCE — instead
+# of shared memory and TCP alone. That was the whole point of adding rdma-core,
+# and a library nothing calls is not delivered.
+#
+# The bottle was checked before the flag was added rather than after: it carries
+# include/infiniband/verbs.h and lib/libibverbs.so, which are exactly the header
+# and symbol src/uct/ib/configure.m4 probes for.
+#
+# ROCm followed, for the same reason: github.com/ROCm/ROCR-Runtime is in the
+# pantry now, so `--with-rocm` gives the GPU transports instead of nothing.
+# UCX's config/m4/rocm.m4 states its requirement exactly — -I$ROCM/include/hsa,
+# -lhsa-runtime64 -lhsakmt, probing hsa.h, hsa_ext_amd.h and hsa_init() — and
+# the ROCr bottle was checked against that list before the flag was added, not
+# after: it carries include/hsa/hsa.h, include/hsa/hsa_ext_amd.h,
+# lib/libhsa-runtime64.so and lib/libhsakmt.a. All four, and the archive rather
+# than a shared object for hsakmt, which is what -lhsakmt needs.
+#
+# The dependency costs 688 KB. It is linux-only, like this package.
+#
+# CUDA remains off for now. nvidia.com/cuda-cudart is in the pantry, but its
+# lib/stubs/libcuda.so would make libuct_cuda.so record a NEEDED on libcuda.so.1
+# that no package provides — resolved at runtime by the machine's own driver,
+# which is right. go-pkgx/bottle#63 taught the closure scanner that boundary;
+# turning the flag on is the next step, on its own, so it is verifiable on its
+# own.
+
+distributable:
+  url: https://github.com/openucx/ucx/releases/download/v{{version}}/ucx-{{version}}.tar.gz
+  strip-components: 1
+
+versions:
+  github: openucx/ucx
+
+# linux only, deliberately. UCX compiles on darwin with self/tcp alone, which is
+# what the OS gives you anyway; shipping it there would suggest a capability
+# that is not present.
+platforms:
+  - linux
+
+dependencies:
+  zlib.net: ^1.3
+  # Runtime, not build-only: libuct_ib.so links libibverbs, and
+  # libuct_rocm.so links libhsa-runtime64.
+  github.com/linux-rdma/rdma-core: '*'
+  # ROCr only builds for x86-64 (upstream's utils.h calls an x86 intrinsic
+  # unguarded), so the dependency is keyed the same way. Declaring it for both
+  # arches would fail resolution on aarch64 for a transport that could not be
+  # built there anyway.
+  linux/x86-64:
+    github.com/ROCm/ROCR-Runtime: '*'
+
+build:
+  dependencies:
+    gnu.org/autoconf: '*'
+    gnu.org/automake: '*'
+    gnu.org/libtool: '*'
+    gnu.org/m4: '*'
+    freedesktop.org/pkg-config: ^0.29
+  script:
+    # UCX hardcodes `BASE_CFLAGS="-g -Wall -Werror"` in configure (config/m4/
+    # compiler.m4:13) and offers no switch to turn it off. Its own sources do
+    # not survive a clang newer than the one it was written against:
+    #
+    #   config/parser.c:648: assigning to 'char *' from 'const char *'
+    #     discards qualifiers [-Werror,-Wincompatible-pointer-types-…]
+    #   ptmalloc286/malloc.c:4000: variable 'nfences' set but not used
+    #     [-Werror,-Wunused-but-set-variable]
+    #
+    # the second in a vendored allocator UCX did not write. Dropping -Werror
+    # keeps every warning visible and stops them being fatal; it does not
+    # silence anything.
+    - sed -i 's/-Wall -Werror/-Wall/' configure
+    # iodemo is a test app, and it is built unconditionally: test/apps/
+    # Makefile.am puts `SUBDIRS += iodemo` ABOVE the `if HAVE_TEST_APPS`
+    # block, so --disable-test-apps (already the default) does not exclude it.
+    # It uses std::random_shuffle, removed in C++17:
+    #
+    #   io_demo.cc:3035: error: no member named 'random_shuffle' in namespace 'std'
+    #
+    # Nothing here ships it — `provides` lists ucx_info, ucx_perftest and
+    # ucx_read_profile — so drop the one subdirectory rather than move the
+    # whole build back to C++14 for a demo.
+    - sed -i 's|^SUBDIRS = profiling iodemo$|SUBDIRS = profiling|' test/apps/Makefile.in
+    - ./configure $ARGS
+    - make --jobs {{hw.concurrency}}
+    - make install
+  env:
+    ARGS:
+      - --prefix={{prefix}}
+      - --libdir={{prefix}}/lib
+      - --disable-dependency-tracking
+      - --disable-silent-rules
+      - --disable-logging
+      - --disable-debug
+      - --disable-assertions
+      - --disable-params-check
+      - --without-java
+      - --without-go
+      # Named rather than left to autodetection: a transport that silently did
+      # not get built is the kind of thing nobody notices until a benchmark is
+      # half as fast as it should be.
+      - --without-cuda
+      # An explicit prefix rather than bare `--with-verbs`, which means /usr —
+      # a directory a from-scratch rootfs does not have, and `test -d` on it
+      # decides the whole feature silently.
+      - --with-verbs={{deps.github.com/linux-rdma/rdma-core.prefix}}
+    # ROCm is keyed by arch because ROCr is: upstream's utils.h calls an x86
+    # intrinsic unguarded, so there is no aarch64 bottle to point at.
+    linux/x86-64:
+      ARGS:
+        - --with-rocm={{deps.github.com/ROCm/ROCR-Runtime.prefix}}
+    linux/aarch64:
+      ARGS:
+        - --without-rocm
+
+provides:
+  - bin/ucx_info
+  - bin/ucx_perftest
+  - bin/ucx_read_profile
+
+test:
+  # ucx_info -d lists the transports that were actually compiled in. Asserting
+  # shared memory is the point of the package: if only self and tcp are there,
+  # the bottle is no better than no bottle.
+  script:
+    - ucx_info -v | grep -q "Library version"
+    - ucx_info -d | grep -q "Transport: posix"
+    - ucx_info -d | grep -q "Transport: sysv"
+    # The ib transports cannot be LISTED on a build machine with no HCA — the
+    # devices are not there — so assert what can be honestly asserted: that the
+    # module was built. Its absence is what a silently-declined --with-verbs
+    # looks like, and that is the failure this line exists to catch.
+    - test -f {{prefix}}/lib/ucx/libuct_ib.so
+    # Same reasoning for ROCm: a build machine has no AMD GPU, so `ucx_info -d`
+    # cannot list a rocm transport, but a silently declined --with-rocm looks
+    # exactly like a missing module — and configure DOES decline silently, with
+    # a warning nobody reads.
+    #
+    # Only where ROCr exists. Asserting the module on aarch64 would fail a build
+    # for the absence of something deliberately not asked for.
+    - |
+      case "$(uname -m)" in
+        x86_64) test -f {{prefix}}/lib/ucx/libuct_rocm.so ;;
+        *) echo "no rocm transport on $(uname -m): ROCr is x86-64 only" ;;
+      esac
