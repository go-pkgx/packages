diff --git a/projects/kernel.org/linux/package.yml b/projects/kernel.org/linux/package.yml
new file mode 100644
index 0000000..d1de1e9
--- /dev/null
+++ b/projects/kernel.org/linux/package.yml
@@ -0,0 +1,131 @@
+distributable:
+  url: https://cdn.kernel.org/pub/linux/kernel/v{{version.major}}.x/linux-{{version}}.tar.xz
+  strip-components: 1
+
+# Same sources as kernel.org/linux-headers, which packages the headers out of
+# this very tarball. This project packages the KERNEL: a bootable image plus the
+# .config that produced it, so a microVM can pull its kernel from the registry
+# exactly like it pulls any other package.
+versions:
+  - url: "https://cdn.kernel.org/pub/linux/kernel/v6.x/"
+    match: /linux-\d+\.\d+\.\d+\.tar\.xz/
+    strip:
+      - /linux-/
+      - /\.tar\.xz/
+
+platforms: linux
+
+provides:
+  - boot/Image
+
+build:
+  dependencies:
+    gnu.org/bc: '*'          # the build does constant maths with it
+    gnu.org/bison: '*'       # kconfig's parser
+    github.com/westes/flex: '*'
+    openssl.org: ^3          # module signing
+    gnu.org/gawk: '*'
+    # objtool (x86 only) includes <gelf.h>: the build container has no libelf
+    # headers, so the whole kernel died there while aarch64 sailed past. The
+    # bottle carries include/gelf.h, and CPATH now reaches it.
+    elfutils.org: '*'
+  script:
+    # A microVM kernel, not a distro one: start from the smallest sane base and
+    # enable exactly what a guest needs to mount its rootfs over virtio-fs and
+    # run an OCI container in it. Every option below has a reason — a kernel
+    # config with unexplained lines is a config nobody dares change.
+    - make defconfig
+    - run: |
+        # RDMA, and the software transports that make it reachable without
+        # hardware. rdma-core is in the pantry now, and libibverbs opens
+        # /dev/infiniband/uverbs* — a device this kernel did not create, so the
+        # userspace half had nothing to talk to. RXE (soft-RoCE) and SIW
+        # (soft-iWARP) give a working RDMA stack over ordinary Ethernet, which
+        # is what makes UCX's --with-verbs path testable in a microVM on a
+        # laptop rather than only on a cluster.
+        #
+        # mlx5 is the HCA an actual cluster has, and only reachable in a guest
+        # once VFIO can hand the device through. VFIO earns its place the same
+        # way for GPUs. PCI_P2PDMA is GPUDirect: the NIC reading GPU memory
+        # without a bounce through the host.
+        #
+        # All =y, because MODULES is disabled below: a microVM kernel that
+        # needed a modules tree beside it would not be one artefact any more.
+        ./scripts/config \
+          --enable VIRTIO --enable VIRTIO_PCI --enable VIRTIO_MMIO \
+          --enable VIRTIO_BLK --enable VIRTIO_NET --enable VIRTIO_CONSOLE \
+          --enable FUSE_FS --enable VIRTIO_FS \
+          --enable CGROUPS --enable BLK_CGROUP --enable CGROUP_SCHED \
+          --enable CGROUP_PIDS --enable CGROUP_FREEZER --enable CGROUP_DEVICE \
+          --enable MEMCG --enable NAMESPACES --enable USER_NS --enable PID_NS \
+          --enable NET_NS --enable UTS_NS --enable IPC_NS \
+          --enable OVERLAY_FS --enable SECCOMP --enable SECCOMP_FILTER \
+          --enable TMPFS --enable TMPFS_POSIX_ACL --enable DEVTMPFS \
+          --enable DEVTMPFS_MOUNT --enable BLK_DEV_INITRD --enable RD_GZIP \
+          --enable INFINIBAND --enable INFINIBAND_USER_ACCESS \
+          --enable INFINIBAND_ADDR_TRANS --enable RDMA_RXE --enable RDMA_SIW \
+          --enable MLX5_CORE --enable MLX5_INFINIBAND \
+          --enable VFIO --enable VFIO_PCI --enable VFIO_IOMMU_TYPE1 \
+          --enable TRANSPARENT_HUGEPAGE --enable PCI_P2PDMA \
+          --disable MODULES
+        make olddefconfig
+    # $KERNEL_IMAGE is the target and $KERNEL_IMAGE_PATH where it lands: Image on
+    # arm64, bzImage on x86-64 — the very file the microVM runtime boots.
+    # KCFLAGS, and this one flag, for a collision of ORDER rather than a bug on
+    # either side. bk's driver carries link flags on every invocation
+    # (--rtlib=compiler-rt, -fuse-ld=lld, --unwindlib=none, -L…) plus a
+    # -Wno-unused-command-line-argument to keep clang quiet about them when it
+    # is merely compiling. The kernel then asks for
+    #
+    #     -Werror=unused-command-line-argument
+    #
+    # explicitly — and -Werror=X RE-ENABLES X even when -Wno-X came earlier, so
+    # the kernel's flag wins on position and every compile-only step dies:
+    #
+    #     clang: error: argument unused during compilation: '--rtlib=compiler-rt'
+    #     make[2]: *** [scripts/Makefile.build:184:
+    #       scripts/mod/devicetable-offsets.s] Error 1
+    #
+    # kbuild appends KCFLAGS AFTER its own flags, so this is the one place the
+    # order can be settled without touching either party's defaults.
+    # No -Wno- crutches here any more. The link flags that made every
+    # compile-only step fail — and, worse, made kbuild's warning PROBES fail, so
+    # the kernel dropped the warnings it meant to disable — are no longer handed
+    # to a compile-only invocation at all (go-pkgx/bk#111). KCFLAGS did not fix
+    # it: the probes never see KCFLAGS, and eleven unused-argument errors
+    # survived that attempt, which is what located the defect in the shim.
+    - make --jobs {{ hw.concurrency }} $KERNEL_IMAGE
+    - mkdir -p "{{prefix}}/boot" "{{prefix}}/share/kernel"
+    - cp "$KERNEL_IMAGE_PATH" "{{prefix}}/boot/Image"
+    - cp .config "{{prefix}}/share/kernel/config"
+  env:
+    # The kernel compiles its HOST tools (certs/extract-cert, scripts/dtc…) with
+    # KBUILD_HOSTCFLAGS and the container's own gcc, so none of the toolchain's
+    # C23 demotions reach them: scripts/ssl-common.h calls errx() without
+    # including <err.h> and gcc-14 makes that implicit declaration fatal.
+    # Demote it here, for the host tools only — the kernel proper still builds
+    # under its own flags. HOSTCFLAGS and not KBUILD_HOSTCFLAGS: the Makefile
+    # BUILDS the latter (`KBUILD_HOSTCFLAGS := … $(HOSTCFLAGS) …`), so setting it
+    # from the environment is overwritten, while HOSTCFLAGS is appended.
+    HOSTCFLAGS: -Wno-implicit-function-declaration -Wno-implicit-int -Wno-int-conversion
+    linux/aarch64:
+      KERNEL_IMAGE: Image
+      KERNEL_IMAGE_PATH: arch/arm64/boot/Image
+    linux/x86-64:
+      KERNEL_IMAGE: bzImage
+      KERNEL_IMAGE_PATH: arch/x86/boot/bzImage
+
+test:
+  # A kernel cannot be run by the test harness, so check the artefact is what it
+  # claims: a bootable image of non-zero size, and a config carrying the options
+  # the microVM runtime depends on.
+  script: |
+    test -s {{prefix}}/boot/Image
+    grep -q "^CONFIG_VIRTIO_FS=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_OVERLAY_FS=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_USER_NS=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_INFINIBAND_USER_ACCESS=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_INFINIBAND_ADDR_TRANS=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_RDMA_RXE=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_VFIO_PCI=y" {{prefix}}/share/kernel/config
+    grep -q "^CONFIG_TRANSPARENT_HUGEPAGE=y" {{prefix}}/share/kernel/config
