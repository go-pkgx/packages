diff --git a/projects/openprinting.github.io/cups/package.yml b/projects/openprinting.github.io/cups/package.yml
--- a/projects/openprinting.github.io/cups/package.yml
+++ b/projects/openprinting.github.io/cups/package.yml
@@ -14,6 +14,17 @@
 build:
   script:
     - ./configure $ARGS
+    # --disable-debug leaves INSTALL_STRIP=-s, so `install -c -s` strips the
+    # dylib AFTER the arm64 linker has ad-hoc signed it. What lands carries a
+    # signature describing the pre-strip file, and fixup refuses it:
+    #   libcups.2.dylib: fixup: malformed Mach-O code signature:
+    #     code limit 589920 is not within the 534272-byte slice
+    # @INSTALL_STRIP@ is an autoconf SUBSTITUTION, not a make variable, so
+    # `make INSTALL_STRIP= install` changes nothing — the `-s` is baked into
+    # Makedefs. Take it out of the two lines that carry it.
+    # The size this costs is 56 KiB on libcups; a signature that does not
+    # describe its own bytes costs the whole bottle.
+    - sed -i -E 's/^(INSTALL_(BIN|LIB)[[:space:]]*=.*[^-])[[:space:]]-s[[:space:]]*$/\1/' Makedefs
     - make --jobs {{ hw.concurrency }} install
   env:
     ARGS:
