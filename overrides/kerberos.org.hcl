project = "kerberos.org"
why     = "This recipe pins openssl to a 1.x line. Our registry holds no 1.x bottle — every one of the 48 is 3.x or 4.x — so the recipe dies in the resolver before a compiler runs: `no version of openssl.org satisfies \"^1.1\"`. openssl 1.1.1 has been end-of-life since September 2023, so pinning it is not an alternative. Generated by ./openssl3; delete this when upstream retargets the pin."

edits = [
  {
    path = "dependencies[\"openssl.org\"]"
    set  = "^3"
  },
  {
    why  = "krb5's own configure adds a large warning set and promotes several of them to errors, and one now fails on krb5's own source under the sovereign clang: `ccbase.c:213:8: error: assigning to 'char *' from 'const char *' discards qualifiers [-Werror,-Wincompatible-pointer-types-discards-qualifiers]` on `cp = strchr(name, ':')`, covered by the `-Werror=incompatible-pointer-types` configure passes itself. Those flags are generated by configure and land AFTER anything the recipe sets, so appending to CFLAGS cannot un-promote them. krb5 provides the opt-out: src/aclocal.m4 reads `krb5_ac_warn_cflags_set=$${WARN_CFLAGS+set}` (line 451) and then `if test \"x$krb5_ac_warn_cflags_set\" = xset ; then AC_MSG_NOTICE(not adding extra gcc warning flags because WARN_CFLAGS was set)` (line 527) — `$${VAR+set}` is non-empty when VAR is DEFINED, empty or not. Delete this when upstream's source stops discarding the qualifier."
    path = "build.env.ARGS"
    append = ["WARN_CFLAGS="]
  },
]
