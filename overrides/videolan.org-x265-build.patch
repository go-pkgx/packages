diff --git a/projects/videolan.org/x265/package.yml b/projects/videolan.org/x265/package.yml
index 4e6d2f8..2f088ce 100644
--- a/projects/videolan.org/x265/package.yml
+++ b/projects/videolan.org/x265/package.yml
@@ -14,6 +14,53 @@ build:
     nasm.us: '*'
   working-directory: 8bit
   script:
+    # x265 3.x does not configure under CMake 4. Three distinct refusals, and
+    # the fix for each is different:
+    #
+    #   CMakeLists.txt:10  cmake_policy(SET CMP0025 OLD) — refused outright;
+    #                      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 does not help
+    #   CMakeLists.txt:20  cmake_minimum_required (VERSION 2.8.8)
+    #   dynamicHDR10/CMakeLists.txt:13  the same, at 2.8.11 — reached only
+    #                      because this recipe passes -DENABLE_HDR10_PLUS=ON
+    #
+    # Dropping the OLD policies is not enough on its own. CMP0025 NEW reports
+    # Apple's compiler as AppleClang rather than Clang, and line 150 reads
+    #     if(${CMAKE_CXX_COMPILER_ID} STREQUAL "Clang")
+    # so the whole block below it — add_definitions(-Wall -Wextra -Wshadow …)
+    # and everything else guarded by GCC — is SILENTLY skipped. Measured on the
+    # configured tree: with MATCHES, 6 generated files carry -Wshadow; with
+    # STREQUAL under CMP0025 NEW, zero. A build that quietly loses its compiler
+    # flags is worse than one that refuses.
+    #
+    # CMP0054 OLD is dropped with no replacement: its only two sites are
+    # `if("${CMAKE_SIZEOF_VOID_P}" MATCHES 8)`, already-expanded quoted
+    # arguments the policy does not govern.
+    #
+    # Written over every CMakeLists.txt rather than the two that fail today:
+    # the second one was found only after the first was fixed and the build was
+    # run again, which is a round trip per file.
+    #
+    # Checked before committing, on pristine 3.6 sources: configures with
+    # cmake 4.3.2 and -DENABLE_HDR10_PLUS=ON, rc=0, zero CMake errors.
+    - run: |
+        python3 - <<'EOF'
+        import glob, re
+        changed = []
+        for p in glob.glob("source/**/CMakeLists.txt", recursive=True):
+            s = open(p).read()
+            before = s
+            s = re.sub(r'if\(POLICY (CMP0025|CMP0054)\)\n *cmake_policy\(SET \1 OLD\)[^\n]*\n *endif\(\)\n', '', s)
+            s = re.sub(r'(cmake_minimum_required *\( *VERSION *)(2(?:\.\d+)*)', r'\g<1>3.5', s)
+            s = s.replace('${CMAKE_CXX_COMPILER_ID} STREQUAL "Clang"', '${CMAKE_CXX_COMPILER_ID} MATCHES "Clang"')
+            if s != before:
+                open(p, "w").write(s)
+                changed.append(p)
+        assert changed, "nothing changed — the shapes this patch targets are gone"
+        print("patched:", " ".join(changed))
+        EOF
+      working-directory: ..
+      if: <4
+
     - run: |
         cmake ../source -DENABLE_HDR10_PLUS=ON $ARGS_DEFAULT $HIGHBITARGS
         make
@@ -31,7 +78,18 @@ build:
         make
         mv libx265.a libx265_main.a
 
-    - run: libtool -static -o $LIB_ARGS
+    # `libtool` here means APPLE's libtool — the cctools archiver that merges
+    # static libraries, whose -static flag GNU libtool does not have. Which one
+    # answers depends on PATH, and in this factory gnu.org/libtool is on it:
+    #
+    #   + libtool -static -o libx265.a libx265_main.a libx265_main10.a ...
+    #   Usage: /Users/runner/.pkgx/gnu.org/libtool/v2.6.2/bin/libtool [OPTION]...
+    #   libtool:   error: unrecognised option: '-static'
+    #
+    # after a build that had already reached 100%. A recipe that means the
+    # system tool has to name it: the day the factory ships a package of the
+    # same name, PATH answers with ours.
+    - run: /usr/bin/libtool -static -o $LIB_ARGS
       if: darwin
 
     - run: ar crs $LIB_ARGS
