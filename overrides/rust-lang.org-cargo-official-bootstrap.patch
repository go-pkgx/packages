diff --git a/projects/rust-lang.org/cargo/package.yml b/projects/rust-lang.org/cargo/package.yml
index 70bfeab..7e5f567 100644
--- a/projects/rust-lang.org/cargo/package.yml
+++ b/projects/rust-lang.org/cargo/package.yml
@@ -33,6 +33,32 @@ build:
     tukaani.org/xz: "*"
     rust-lang.org/cargo: "*"
   script:
+    # BOOTSTRAP: cargo is built by cargo, and the published bottle of it is
+    # linked against OpenSSL 1.1 — checked on the artifact itself, both ours and
+    # upstream's carry libssl.so.1.1 — so it cannot start here at all:
+    #   cargo: error while loading shared libraries: libssl.so.1.1
+    # We have no linux 1.1 bottle, and publishing an EOL crypto library under our
+    # own signature to bootstrap ONE package is a poor trade. Rust's own cargo
+    # has no dynamic OpenSSL dependency (checked the same way), so bootstrap on
+    # that instead: it is a build-time binary, never published, exactly like the
+    # source tarball beside it. Pinned and checksummed, because an unverified
+    # binary in a build is a worse problem than the one it solves.
+    - run: |
+        set -eu
+        case "$(uname -m)" in
+          x86_64)  BT=x86_64-unknown-linux-gnu;  SUM=dc0f70c6e681776d0c5e01953b50488e8b2f972eed5aece6d094e497ea480ab0 ;;
+          aarch64) BT=aarch64-unknown-linux-gnu; SUM=33527828bc38026702d85996a28c08a894d5376a5756dd9085247d36aa208405 ;;
+          *) echo "no pinned bootstrap cargo for $(uname -m)" >&2; exit 1 ;;
+        esac
+        T="cargo-1.90.0-$BT.tar.gz"
+        curl -fsSLo "$T" "https://static.rust-lang.org/dist/$T"
+        echo "$SUM  $T" | sha256sum -c -
+        tar xzf "$T"
+        mkdir -p "$PWD/.bootstrap"
+        mv "cargo-1.90.0-$BT/cargo/bin/cargo" "$PWD/.bootstrap/cargo"
+        export PATH="$PWD/.bootstrap:$PATH"
+      if: linux
+
     # otherwise we are not ABI compatible and new macOS versions may break
     # this happened with Sonoma
     # this instead seems to break cargo on sonoma
