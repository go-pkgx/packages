diff --git a/projects/gnu.org/grep/package.yml b/projects/gnu.org/grep/package.yml
index f596893..9d61549 100644
--- a/projects/gnu.org/grep/package.yml
+++ b/projects/gnu.org/grep/package.yml
@@ -15,6 +15,19 @@ dependencies:
 build:
   dependencies:
     freedesktop.org/pkg-config: ^0.29
+    # GNU grep's configure accepts no grep but a GNU one - macOS's BSD grep
+    # is refused - and bk keeps a package's own bottle out of the BASE
+    # toolchain of its own build (go-pkgx/bk#105), so grep names itself
+    # here, deliberately. A recipe asking for itself is allowed precisely
+    # for cases like this one.
+    #
+    # The risk it carries: if the published grep ever becomes unstartable,
+    # this line hands the build a broken tool and grep can no longer be
+    # rebuilt. That happened - a dependency's minor upgrade moved out from
+    # under an absolute install name - and is what go-pkgx/bk#104 and #107
+    # (major-versioned references) exist to prevent. If it recurs, DELETE
+    # this line: configure will then test the system grep and say so.
+    gnu.org/grep: "*"
   script: |
     ./configure $ARGS
     make --jobs {{ hw.concurrency }} install
