new file mode 100644
index 0000000..d41cead
--- /dev/null
+++ b/projects/nvidia.com/cuda-cudart/package.yml
@@ -0,0 +1,84 @@
+# CUDA Runtime (cudart), from NVIDIA's own redistributable set.
+#
+# ── The licence question, stated rather than assumed ────────────────────────
+# NVIDIA publishes these archives under compute/cuda/redist/ with a JSON
+# manifest per toolkit release, and the CUDA Toolkit EULA shipped inside each
+# archive names, in Attachment A, exactly which files may be distributed:
+#
+#     Component: CUDA Runtime
+#     Linux: libcudart.so, libcudart_static.a, libcudadevrt.a
+#
+# with the condition that they are distributed "with applications developed by
+# you". Whether a package REGISTRY meets that condition is a judgement, and the
+# ecosystem has answered it both ways: conda-forge mirrors these archives,
+# Spack downloads them from NVIDIA at install time and republishes nothing.
+#
+# This recipe downloads from NVIDIA and verifies NVIDIA's own sha256. Publishing
+# the resulting bottle is the step that constitutes redistribution, and that is
+# a decision for the maintainer, not for a build script.
+#
+# ── Why cudart first ────────────────────────────────────────────────────────
+# It is what a GPU-aware transport links against. UCX's --with-cuda needs
+# libcudart plus the driver stub this archive carries; the driver itself is not
+# redistributable and is not here — it comes from the machine's own NVIDIA
+# installation, which is where it belongs.
+
+versions:
+  # The redist root lists one manifest per toolkit release. Component versions
+  # differ from toolkit versions (cudart 12.8.57 ships in toolkit 12.8.0), so
+  # the manifest is read at build time rather than guessed at here.
+  url: https://developer.download.nvidia.com/compute/cuda/redist/
+  match: /redistrib_\d+\.\d+\.\d+\.json/
+  strip:
+    - /^redistrib_/
+    - /\.json$/
+
+platforms:
+  - linux
+
+build:
+  dependencies:
+    python.org: ^3
+    curl.se: '*'
+  script:
+    # NVIDIA's manifest is the source of truth for the component version, the
+    # per-architecture path AND the checksum. Reading it beats hardcoding three
+    # things that move independently.
+    # curl fetches, python only parses. The pantry's python has no usable ssl
+    # module in this environment — `urllib` answers "unknown url type: https" —
+    # and a build that depends on a language runtime's TLS to reach a vendor is
+    # one more thing that can break for a reason unrelated to the package.
+    - curl -fsSL -o redistrib.json
+      https://developer.download.nvidia.com/compute/cuda/redist/redistrib_{{version}}.json
+    - |
+      python3 - <<'PY' > component.txt
+      import json
+      # pkgx says x86-64 / aarch64; NVIDIA says x86_64, and distinguishes sbsa
+      # (server ARM, what a cluster has) from aarch64 (Tegra). HPC wants sbsa.
+      arch = {"x86-64": "linux-x86_64", "aarch64": "linux-sbsa"}["{{hw.arch}}"]
+      c = json.load(open("redistrib.json"))["cuda_cudart"]
+      if arch not in c:
+          raise SystemExit(f"cuda_cudart has no {arch} in this toolkit")
+      print(c["version"], c[arch]["relative_path"], c[arch]["sha256"])
+      PY
+    - cat component.txt
+    - curl -fsSL -o cudart.tar.xz
+      "https://developer.download.nvidia.com/compute/cuda/redist/$(cut -d' ' -f2 component.txt)"
+    # NVIDIA publishes the checksum beside the archive; verify before unpacking
+    # rather than trust the transport.
+    - echo "$(cut -d' ' -f3 component.txt)  cudart.tar.xz" | sha256sum -c -
+    - mkdir -p {{prefix}}
+    - tar -xJf cudart.tar.xz --strip-components=1 -C {{prefix}}
+    # The archive carries a pkg-config dir keyed to NVIDIA's own layout; drop it
+    # rather than ship .pc files whose prefixes point where nothing is.
+    - rm -rf {{prefix}}/pkg-config
+
+provides: []
+
+test:
+  # No GPU on a build machine, and none needed: what this package owes its
+  # consumers is a linkable runtime with headers, which is checkable without one.
+  script:
+    - test -f {{prefix}}/lib/libcudart.so
+    - test -f {{prefix}}/include/cuda_runtime.h
+    - test -f {{prefix}}/LICENSE
