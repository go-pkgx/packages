+  #   libboost_iostreams.dylib -> @rpath/sourceware.org/bzip2/v1/lib/libbz2.dylib
+  #
+  # so a closure that installs boost and not bzip2 cannot load it. ^1 is the
+  # major that reference records, not a guess.
+  #
+  # Found by `bk undeclared`. It was invisible until the rebuild for
+  # go-pkgx/packages#235 cleared the 12 bare @rpath references that had been
+  # failing first.
+  sourceware.org/bzip2: ^1
 
