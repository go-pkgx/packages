diff --git a/projects/llvm.org/package.yml b/projects/llvm.org/package.yml
index 1363f32..b3fc3a4 100644
--- a/projects/llvm.org/package.yml
+++ b/projects/llvm.org/package.yml
@@ -38,6 +38,30 @@ build:
     crates.io/semverator: '*'
   working-directory: build
   script:
+    - |
+      echo "=== toolchain probe (throwaway branch, go-pkgx/packages#133) ==="
+      /usr/bin/c++ --version || true
+      echo "xcode-select: $(xcode-select -p 2>&1)"
+      echo "sdk: $(xcrun --show-sdk-path 2>&1) version $(xcrun --show-sdk-version 2>&1)"
+      echo "--- predefined macros the driver sets:"
+      /usr/bin/c++ -std=c++17 -pedantic -stdlib=libc++ -mmacosx-version-min=11.0 -dM -E -x c++ /dev/null 2>/dev/null | grep -E "__DARWIN_C_LEVEL|_POSIX_C_SOURCE|__STRICT_ANSI__|__APPLE__|_XOPEN_SOURCE" || echo "(none of them are predefined)"
+      echo "--- _LIBCPP_VERSION:"
+      echo '#include <version>' | /usr/bin/c++ -std=c++17 -stdlib=libc++ -dM -E -x c++ - 2>/dev/null | grep -E "_LIBCPP_VERSION" || echo "(unknown)"
+      echo "--- does <locale> compile ALONE with the same flags?"
+      if echo '#include <locale>' | /usr/bin/c++ -std=c++17 -pedantic -stdlib=libc++ -mmacosx-version-min=11.0 -x c++ -c - -o /dev/null 2>/tmp/probe.err; then
+        echo "PROBE: <locale> alone COMPILES — so the failure needs something else in the TU"
+      else
+        echo "PROBE: <locale> alone FAILS — the SDK on this image is the story"
+        head -20 /tmp/probe.err
+      fi
+      echo "--- and through <functional>, the real chain:"
+      if echo '#include <functional>' | /usr/bin/c++ -std=c++17 -pedantic -stdlib=libc++ -mmacosx-version-min=11.0 -x c++ -c - -o /dev/null 2>/tmp/probe2.err; then
+        echo "PROBE: <functional> COMPILES"
+      else
+        echo "PROBE: <functional> FAILS — reproduced in three lines"
+        head -20 /tmp/probe2.err
+      fi
+      echo "=== end probe ==="
     # Building compiler-rt on darwin+aarch64 fails for versions less than
     # 14 with the below configuration. FIXME if possible, of course.
     - run: |
@@ -102,6 +126,28 @@ build:
         - -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON
     darwin:
       ARGS:
+        # WITHOUT this, every Mach-O here can only run on the machine that built
+        # it. llvm/cmake/modules/AddLLVM.cmake's llvm_setup_rpath sets each
+        # target's INSTALL_RPATH to "@loader_path/../lib" on Apple and turns on
+        # BUILD_WITH_INSTALL_RPATH — so the -Wl,-rpath flags bk supplies through
+        # LDFLAGS never reach the installed binary, and no later fix-up can add
+        # one, because an LC_RPATH load command cannot grow in place.
+        #
+        # From bin/, "@loader_path/../lib" is llvm's own lib directory. The
+        # references it must resolve are to SIBLING packages —
+        # @rpath/zlib.net/v1.3.1/lib/libz.1.3.1.dylib — which live one level
+        # above the project directory. Published, that left clang-22 with one
+        # usable rpath and one absolute /Users/runner/.pkgx, so on any machine
+        # but the runner:
+        #
+        #   dyld: Library not loaded: @rpath/zlib.net/v1.3.1/lib/libz.1.3.1.dylib
+        #
+        # 145 of the bottle's 145 Mach-O files with an LC_RPATH were in that
+        # state. llvm_setup_rpath returns early when CMAKE_INSTALL_RPATH is
+        # already set, which is the hook upstream provides for exactly this.
+        # $PKGX_DIR is <prefix>/../.. and bin/ and lib/ are both one level under
+        # the prefix, so one relative entry serves both.
+        - -DCMAKE_INSTALL_RPATH="@loader_path/../lib;@loader_path/../../.."
         #FIXME shouldn’t *have to* require the command line tools package
         #FIXME this is no good for systems with only Xcode installed
         #NOTE how do Apple make their LLVM find both? we want the same trick
